# MESA — configuración local / Cloudflare

# Token privado para administración (guardar como Cloudflare Secret)
MESA_ADMIN_TOKEN=

# Origen permitido. En producción puede quedar * porque la API pública
# expone solamente vistas seguras y las escrituras administrativas requieren token.
ALLOWED_ORIGIN=http://localhost:4173

# Persistencia real:
# - DB: binding Cloudflare D1 definido en wrangler.toml
# - DOCS: binding Cloudflare R2 opcional para adjuntos
